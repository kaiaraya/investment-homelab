# Homelab Core Configuration
PROJECT_NAME="Investment Homelab Gateway"
API_V1_STR="/api/v1"
DATABASE_URL="sqlite+aiosqlite:///./investment_homelab.db"

# Webhook Security Key (Required for all incoming LINE/External requests)
HOMELAB_SECRET_KEY="change-me-generate-a-random-key"

# LINE Messaging API Configuration
LINE_CHANNEL_SECRET="mock_line_channel_secret"
LINE_CHANNEL_ACCESS_TOKEN="mock_line_channel_token"
LINE_SIMULATION_MODE=true

# Scheduler & Notification Volume Control
ENABLE_PHASE3_SCHEDULER=false
ENABLE_PROGRESS_NOTIFICATIONS=false

# Pre-trade Risk & Guard Configuration
MAX_ORDER_VALUE_THB=1000000.0
ORDER_IDEMPOTENCY_WINDOW_SEC=10

# Optional AI API Key for LLM Signal Parsing (Heuristic fallback is always active)
GEMINI_API_KEY=""

# Target Trading Platform: "CLICK2WIN" (Settrade Sandbox) or "TRADEMAN" (Krungsri Live)
TRADING_PLATFORM="CLICK2WIN"

# Settrade Click2Win Configuration (No SMS OTP required)
CLICK2WIN_URL="https://click2win.settrade.com"
CLICK2WIN_USERNAME=""
CLICK2WIN_PASSWORD=""
CLICK2WIN_PIN=""
CLICK2WIN_SESSION_PATH="data/click2win_session.json"

# Krungsri Securities Credentials
KRUNGSRI_USERNAME=""
KRUNGSRI_PASSWORD=""
KRUNGSRI_LOGIN_URL="https://www.krungsrisecurities.com/th/main/default.aspx"

# Liberator WebTrade Credentials
LIBERATOR_USERNAME=""
LIBERATOR_PASSWORD=""

# Playwright Browser Configuration
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_CHROME_EXECUTABLE="/usr/bin/google-chrome"
OTP_TIMEOUT_SECONDS=180
SESSION_STATE_PATH="data/session_state.json"
TRADEMAN_URL="https://trademan.in.th"
